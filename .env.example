# Copy to .env (already git-ignored) and fill in. Never commit the real file.

# Used by docker-compose.yml AND by the Go server (it builds the connection URL from these).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional. Defaults: POSTGRES_HOST=127.0.0.1:5432  POSTGRES_SSLMODE=disable
# For a remote database use sslmode=require (or verify-full).
# POSTGRES_HOST=
# POSTGRES_SSLMODE=

# Or give one full URL instead; it takes priority over the POSTGRES_* values above.
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/dbname?sslmode=disable

# Server settings. Keep JWT_SECRET the same between runs, or everyone is logged out.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173