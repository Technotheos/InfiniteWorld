# Copy to .env (already git-ignored) and fill in. Never commit the real file.

# Used by docker-compose.yml AND by the Go server (it builds the connection URL from these).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional. Defaults: POSTGRES_HOST=127.0.0.1:5432  POSTGRES_SSLMODE=disable
# For a remote database use sslmode=require (or verify-full).
# POSTGRES_HOST=
# POSTGRES_SSLMODE=

# Or give one full URL instead; it takes priority over the POSTGRES_* values above.
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/dbname?sslmode=disable

# Server settings. Keep JWT_SECRET the same between runs, or everyone is logged out.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Browser origins allowed to call the API. https:// only, except localhost / private-network
# addresses. No wildcards, no paths. A malformed entry stops the server from starting.
ALLOWED_ORIGINS=http://localhost:5173

# --- Security settings (details in SECURITY.md) ---
# The refresh cookie is Secure by default. Set to false ONLY to test over plain http on a LAN
# address (e.g. from your phone). With a Secure cookie on a non-localhost http address the
# browser silently drops it, so every page reload would log you out. Never false in production.
# COOKIE_SECURE=false
# Who may reach /api/admin/*. Default: this machine only. Comma-separated IPs or CIDR ranges.
# ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# Reverse proxies whose X-Forwarded-For header is believed. Required behind nginx/Caddy/Cloudflare,
# otherwise every visitor looks like the proxy (breaking rate limits and the admin allowlist).
# TRUSTED_PROXIES=
# Hosts the server may fetch URLs from (SSRF guard). Empty means no outbound fetches at all.
# OUTBOUND_ALLOWED_HOSTS=
